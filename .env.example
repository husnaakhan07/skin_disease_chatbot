# Generate secrets locally; never commit a real .env file.
FLASK_SECRET_KEY=
GROQ_API_KEY=
PINECONE_API_KEY=
KAGGLE_API_TOKEN=
# Admin routes stay disabled unless BOTH values are set. Use a strong password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Default is true for HTTPS. For LOCAL HTTP ONLY set false.
SESSION_COOKIE_SECURE=true
PORT=8080

# Comma-separated exact hostnames for your deployment; never use *
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
